# Copy these into your host's "Environment Variables" screen. All are optional.
APP_PASSWORD=choose-a-team-password
PUBLIC_URL=https://your-app.example.com

# Email option A: any SMTP provider (Gmail app password, Brevo, Mailgun, Zoho, Office 365...)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM="Process Safety Tracker <you@example.com>"

# Email option B: Resend (https://resend.com, free tier)
# RESEND_API_KEY=re_xxx
# MAIL_FROM="Process Safety Tracker <alerts@yourdomain.com>"

# Where data + uploads live. Point at a persistent disk/volume on your host.
# DATA_DIR=/data
# SEED_DEMO=false
